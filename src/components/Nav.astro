---
const navLinks = [
  { href: "/", labelDe: "Home", labelEn: "Home" },
  { href: "/leistungen", labelDe: "Leistungen", labelEn: "Services" },
  { href: "/projekte", labelDe: "Projekte", labelEn: "Projects" },
  { href: "/3d-druck", labelDe: "3D-Druck", labelEn: "3D Print" },
  { href: "/kontakt", labelDe: "Kontakt", labelEn: "Contact" },
  { href: "/team", labelDe: "Team", labelEn: "Team" },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span class="logo-mark">FF</span>
      <span class="logo-text">Floforge</span>
    </a>

    <ul class="nav-links">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={["nav-link", { active: currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) }]}
            data-de={link.labelDe}
            data-en={link.labelEn}
          >
            {link.labelDe}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <button class="lang-toggle" id="langToggle" aria-label="Sprache wechseln">
        <span class="lang-de active">DE</span>
        <span class="lang-separator">/</span>
        <span class="lang-en">EN</span>
      </button>

      <button class="nav-burger" id="navBurger" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav-mobile" id="navMobile">
    <ul>
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="nav-mobile-link" data-de={link.labelDe} data-en={link.labelEn}>
            {link.labelDe}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(249, 248, 246, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 4px;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: var(--color-accent);
    background: rgba(200, 82, 26, 0.06);
  }

  .nav-link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .lang-toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    cursor: pointer;
    color: var(--color-text-muted);
    display: flex;
    gap: 0.2rem;
    transition: border-color 0.15s;
  }

  .lang-toggle:hover { border-color: var(--color-accent); }

  .lang-de, .lang-en { transition: color 0.15s; }
  .lang-de.active, .lang-en.active { color: var(--color-accent); font-weight: 600; }
  .lang-separator { color: var(--color-border); }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s;
  }

  .nav-mobile {
    display: none;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-sm);
  }

  .nav-mobile ul { list-style: none; }

  .nav-mobile-link {
    display: block;
    padding: 0.75rem var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: 4px;
    font-size: 1rem;
  }

  .nav-mobile-link:hover { color: var(--color-accent); background: rgba(200, 82, 26, 0.06); }

  @media (max-width: 768px) {
    .nav { height: auto; }
    .nav-links { display: none; }
    .nav-burger { display: flex; }
    .nav-mobile.open { display: block; }
  }
</style>

<script>
  const burger = document.getElementById('navBurger');
  const mobile = document.getElementById('navMobile');
  const langToggle = document.getElementById('langToggle');
  const langDe = langToggle?.querySelector('.lang-de');
  const langEn = langToggle?.querySelector('.lang-en');

  let lang = localStorage.getItem('floforge-lang') || 'de';

  function applyLang(l) {
    lang = l;
    localStorage.setItem('floforge-lang', l);
    const isEn = l === 'en';
    langDe?.classList.toggle('active', !isEn);
    langEn?.classList.toggle('active', isEn);

    document.querySelectorAll('[data-de][data-en]').forEach(el => {
      el.textContent = isEn ? el.dataset.en : el.dataset.de;
    });
  }

  applyLang(lang);

  burger?.addEventListener('click', () => mobile?.classList.toggle('open'));
  langToggle?.addEventListener('click', () => applyLang(lang === 'de' ? 'en' : 'de'));
</script>
