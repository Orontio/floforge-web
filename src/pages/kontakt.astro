---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt – Floforge"
  description="Nehmen Sie Kontakt mit Floforge auf. Projektanfragen, Bodyleasing und allgemeine Fragen."
>

  <section class="contact-section">
    <div class="container contact-layout">

      <!-- LINKE SPALTE: Text -->
      <div class="contact-intro">
        <p class="eyebrow" data-de="Kontakt" data-en="Contact">Kontakt</p>
        <h1 data-de="Lass uns reden." data-en="Let's talk.">Lass uns reden.</h1>
        <p class="intro-text" data-de="Ob Projektanfrage, Bodyleasing oder eine offene Frage – ich melde mich persönlich, in der Regel innerhalb von 24 Stunden." data-en="Whether it's a project inquiry, engineering capacity or a general question – I'll get back to you personally, usually within 24 hours.">
          Ob Projektanfrage, Bodyleasing oder eine offene Frage – ich melde mich persönlich, in der Regel innerhalb von 24 Stunden.
        </p>

        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-label" data-de="E-Mail" data-en="Email">E-Mail</span>
            <a href="mailto:florian@floforge.ch">florian@floforge.ch</a>
          </div>
          <div class="contact-item">
            <span class="contact-label" data-de="Standort" data-en="Location">Standort</span>
            <span data-de="Schweiz" data-en="Switzerland">Schweiz</span>
          </div>
          <div class="contact-item">
            <span class="contact-label" data-de="Sprachen" data-en="Languages">Sprachen</span>
            <span>Deutsch, Englisch</span>
          </div>
        </div>
      </div>

      <!-- RECHTE SPALTE: Formular -->
      <div class="contact-form-wrap">
        <form
          name="kontakt"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
          id="contactForm"
        >
          <!-- Netlify honeypot (Spam-Schutz) -->
          <input type="hidden" name="form-name" value="kontakt" />
          <p style="display:none;"><label>Nicht ausfüllen: <input name="bot-field" /></label></p>

          <div class="form-group">
            <label for="name" data-de="Name *" data-en="Name *">Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Max Muster"
              autocomplete="name"
            />
          </div>

          <div class="form-group">
            <label for="email" data-de="E-Mail *" data-en="Email *">E-Mail *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="max@firma.ch"
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="betreff" data-de="Betreff" data-en="Subject">Betreff</label>
            <select id="betreff" name="betreff">
              <option value="" data-de="— Bitte wählen —" data-en="— Please select —">— Bitte wählen —</option>
              <option value="Projektanfrage" data-de="Projektanfrage" data-en="Project inquiry">Projektanfrage</option>
              <option value="Bodyleasing" data-de="Bodyleasing / Ingenieurszeit" data-en="Engineering capacity">Bodyleasing / Ingenieurszeit</option>
              <option value="Sonstiges" data-de="Sonstiges" data-en="Other">Sonstiges</option>
            </select>
          </div>

          <div class="form-group">
            <label for="nachricht" data-de="Nachricht *" data-en="Message *">Nachricht *</label>
            <textarea
              id="nachricht"
              name="nachricht"
              required
              rows="5"
              placeholder="Beschreiben Sie kurz Ihr Anliegen..."
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            <span data-de="Nachricht senden" data-en="Send message">Nachricht senden</span>
          </button>
        </form>

        <!-- Erfolgs-/Fehlermeldung -->
        <div class="form-success" id="formSuccess" hidden>
          <p data-de="Danke für Ihre Nachricht! Ich melde mich bald." data-en="Thank you for your message! I'll be in touch soon.">
            Danke für Ihre Nachricht! Ich melde mich bald.
          </p>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-section {
    padding: 5rem 0;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: start;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
    max-width: none;
  }

  h1 { margin-bottom: 1.25rem; }

  .intro-text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-item a,
  .contact-item span:last-child {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  /* FORM */
  .contact-form-wrap {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text);
    background: var(--color-bg);
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(200, 82, 26, 0.1);
  }

  textarea { resize: vertical; min-height: 120px; }

  .submit-btn {
    align-self: flex-start;
    min-width: 180px;
  }

  .form-success {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: rgba(200, 82, 26, 0.06);
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .contact-form-wrap {
      padding: 1.5rem;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const success = document.getElementById('formSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as any).toString(),
      });
      form.hidden = true;
      if (success) success.hidden = false;
    } catch {
      alert('Fehler beim Senden. Bitte versuche es erneut.');
    }
  });
</script>
