---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projekte = await getCollection('projekte');
projekte.sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
---

<BaseLayout
  title="Projekte – Floforge"
  description="Ausgewählte Ingenieurprojekte von Floforge: Rohrleitungsbau, Spezialmaschinenbau, FEM-Simulation und mehr."
>

  <section class="projects-section">
    <div class="container">

      <div class="page-header">
        <p class="eyebrow" data-de="Portfolio" data-en="Portfolio">Portfolio</p>
        <h1 data-de="Projekte" data-en="Projects">Projekte</h1>
        <p class="intro" data-de="Ausgewählte Arbeiten – beschrieben als Geschichten, nicht als Referenzlisten." data-en="Selected work – described as stories, not reference lists.">
          Ausgewählte Arbeiten – beschrieben als Geschichten, nicht als Referenzlisten.
        </p>
      </div>

      <div class="projects-grid">
        {projekte.map(projekt => (
          <a href={`/projekte/${projekt.id}`} class="project-card">
            <div class="card-image">
              {projekt.data.titelbild
                ? <img src={projekt.data.titelbild} alt={projekt.data.titel} />
                : <div class="image-placeholder"></div>
              }
            </div>
            <div class="card-body">
              <div class="card-tags">
                {projekt.data.tags.slice(0, 3).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2 class="card-title">{projekt.data.titel}</h2>
              <p class="card-desc">{projekt.data.beschreibung}</p>
              {projekt.data.branche && (
                <p class="card-branche">
                  <span data-de="Branche:" data-en="Industry:">Branche:</span> {projekt.data.branche}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>

      {projekte.length === 0 && (
        <p class="empty" data-de="Projekte werden bald hinzugefügt." data-en="Projects coming soon.">
          Projekte werden bald hinzugefügt.
        </p>
      )}

    </div>
  </section>

</BaseLayout>

<style>
  .projects-section { padding: 5rem 0; }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 600px;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    max-width: none;
  }

  h1 { margin-bottom: 1rem; }

  .intro {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 30px rgba(200, 82, 26, 0.1);
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e8e4df 0%, #d4cfc9 100%);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background: rgba(200, 82, 26, 0.08);
    color: var(--color-accent);
    border-radius: 3px;
    letter-spacing: 0.03em;
  }

  .card-title {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .card-branche {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
